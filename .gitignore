.tmp/
# Local issue tracker (agent skills)
.scratch/

# Build error log written by scripts/learning/error-logger.mjs (machine-specific)
scripts/learning/error-log.json

# Screenshot captures (obsidian-verify recipes)
.shots/
docs/ui-*