{
  "name": "workout-planner",
  "version": "2.8.0",
  "description": "Log every set from your phone, right at the gym, and see your progress in your notes: workout tables, charts, rest timers and a dashboard with PRs, trends and a muscle heat map. Mobile-first, kg or lb per set, all in one CSV file.",
  "main": "main.js",
  "scripts": {
    "dev": "node build-css.mjs && node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node build-css.mjs && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --max-warnings 0 && node scripts/check-readme.mjs",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "doe:validate": "node scripts/validation/check-imports.mjs",
    "doe:analyze-errors": "node scripts/learning/error-analyzer.mjs",
    "doe:generate-component": "node scripts/automation/generate-component.mjs",
    "doe:error-stats": "node scripts/learning/error-logger.mjs stats",
    "doe:prune-errors": "node scripts/learning/error-logger.mjs prune",
    "doe:init-errors": "node scripts/learning/error-logger.mjs init",
    "migrate:i18n": "node scripts/migrate-i18n-constants.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "workout",
    "fitness",
    "charts",
    "data-visualization"
  ],
  "author": "Rares Spatariu",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/json": "^0.14.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^16.18.126",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.25.11",
    "esbuild-postcss": "^0.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-obsidian": "^0.0.1",
    "obsidian": "^1.14.4",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-sort-json": "^4.2.0",
    "sass": "^1.94.2",
    "tinyglobby": "^0.2.17",
    "ts-jest": "^29.4.5",
    "tslib": "2.4.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.72.1"
  }
}
